<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<EnableDefaultItems>false</EnableDefaultItems>
	<IsPackable>true</IsPackable>
	<IncludeBuildOutput>false</IncludeBuildOutput>
	<NoDefaultExcludes>true</NoDefaultExcludes>
	<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	<PackageId>Barisozy.CleanArchitecture.Template</PackageId>
	<Authors>barisozy</Authors>
	<Description>A modern Clean Architecture API solution template.</Description>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageTags>dotnet-new;template;clean-architecture;web-api</PackageTags>
	<PackageType>Template</PackageType>
	<PackageIcon>icon.png</PackageIcon>
	<RepositoryType>git</RepositoryType>
	<RepositoryUrl>https://github.com/barisozy/clean-architecture</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
	<None Include=".template.config/icon.png" Pack="true" PackagePath="" />
	<None Include="README.md" Pack="true" PackagePath="" />
	<!-- A plain 'content/' path makes NuGet place every file under its path relative to the
	     project. Spelling out %(Filename)%(Extension) breaks extensionless files (Dockerfile,
	     LICENSE): NuGet treats a path without an extension as a directory and appends the
	     source path a second time. -->
	<Content Include="**/*"
			  Exclude=".containers/**;.git/**;.vs/**;docs/**;README.md;CleanArchitecture.Template.csproj;artifacts/**;packaging/**;**/bin/**;**/obj/**;**/TestResults/**;.github/workflows/publish-nuget.yml;.github/workflows/template.yml;**/*.user;**/*.suo;**/*.userosscache">
	  <Pack>true</Pack>
	  <PackagePath>content/</PackagePath>
	</Content>
  </ItemGroup>
</Project>
